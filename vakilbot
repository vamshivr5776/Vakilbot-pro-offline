<meta name='viewport' content='width=device-width, initial-scale=1'/><!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VakīlBot Pro — BNS/BNSS Edition</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root {
  --bg:#080809; --surface:#101014; --surface2:#18181f; --surface3:#202028;
  --border:#2c2c38; --gold:#c9973a; --gold-light:#e8c06a; --gold-bright:#f5d78e;
  --gold-dim:rgba(201,151,58,0.12); --red:#d95f5f; --text:#ddd9d0; --text-dim:#7a776e;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;height:100dvh;display:flex;flex-direction:column;overflow:hidden}

/* ENHANCED HEADER */
header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  height: 64px;
  background: rgba(16, 16, 20, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  z-index: 100;
  position: relative;
}

header::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  width: 100%;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  opacity: 0.4;
}

.logo {
  display: flex;
  align-items: center;
  gap: 14px;
}

.logo-seal {
  width: 38px;
  height: 38px;
  background: linear-gradient(135deg, #f5d78e 0%, #c9973a 50%, #a07020 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  box-shadow: 0 0 20px rgba(201, 151, 58, 0.15);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.logo-text-group {
  display: flex;
  flex-direction: column;
}

.logo-text {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--gold-light);
  line-height: 1;
  letter-spacing: -0.01em;
}

.logo-tag {
  font-size: 0.55rem;
  font-family: 'DM Mono', monospace;
  text-transform: uppercase;
  color: var(--text-dim);
  letter-spacing: 1.5px;
  margin-top: 2px;
}

.status-badge {
  background: var(--gold-dim);
  border: 1px solid rgba(201, 151, 58, 0.2);
  padding: 5px 12px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.status-dot {
  width: 6px;
  height: 6px;
  background: var(--gold);
  border-radius: 50%;
  box-shadow: 0 0 8px var(--gold);
  animation: pulse 2s infinite;
}

.status-text {
  font-family: 'DM Mono', monospace;
  font-size: 0.62rem;
  font-weight: 600;
  color: var(--gold-bright);
  letter-spacing: 0.5px;
}

@keyframes pulse {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.4); opacity: 0.6; }
  100% { transform: scale(1); opacity: 1; }
}

/* TOOLS */
.tool-bar{display:flex;gap:10px;padding:10px 20px;background:var(--surface2);border-bottom:1px solid var(--border)}
.tool-btn{background:var(--surface3);border:1px solid var(--border);color:var(--gold-light);padding:6px 14px;border-radius:8px;font-size:.75rem;cursor:pointer;transition:.2s;display:flex;align-items:center;gap:6px}
.tool-btn:hover{border-color:var(--gold);background:var(--gold-dim)}
.tool-btn.active{background:var(--gold);color:#000;border-color:var(--gold)}

/* DOWNLOAD SCREEN */
#download-screen{flex:1;display:flex;align-items:center;justify-content:center;padding:24px}
.dl-card{max-width:480px;width:100%;background:var(--surface);border:1px solid var(--border);border-radius:24px;padding:40px;text-align:center}
.dl-btn{width:100%;padding:16px;background:linear-gradient(135deg,var(--gold),#a07020);color:#1a0e00;border:none;border-radius:12px;font-size:1rem;font-weight:700;cursor:pointer;margin-top:20px}
.progress-wrap{margin-top:20px;display:none;text-align:left}
.progress-bar{height:6px;background:var(--border);border-radius:3px;overflow:hidden;margin:10px 0}
.progress-fill{height:100%;background:var(--gold);width:0%;transition:width .3s}

/* CHAT UI */
#chat-ui{flex:1;display:none;flex-direction:column;overflow:hidden}
#chat-window{flex:1;overflow-y:auto;padding:20px;display:flex;flex-direction:column;gap:15px;scrollbar-width:thin}

.msg-row{display:flex;gap:12px;max-width:90%;animation:fadeUp .2s ease}
.msg-row.user-row{align-self:flex-end;flex-direction:row-reverse}
.av{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.8rem}
.av.bot{background:var(--gold);color:#000}
.av.usr{background:var(--surface3);border:1px solid var(--border)}
.msg{padding:14px 18px;border-radius:18px;line-height:1.6;font-size:.92rem;white-space:pre-wrap}
.msg.user{background:var(--gold-dim);color:var(--gold-bright);border:1px solid var(--gold)}
.msg.bot{background:var(--surface);border:1px solid var(--border)}

/* FORMAL DOC STYLE */
.legal-doc{background:#fff !important;color:#000 !important;font-family:'serif';padding:40px !important;border-radius:4px !important;box-shadow:0 10px 30px rgba(0,0,0,0.5);max-width:100% !important;position:relative; font-size: 1rem !important; margin-top: 10px; border:none !important;}
.doc-actions{margin-top:10px;display:flex;gap:10px; padding-left: 44px; padding-bottom: 20px;}
.action-btn{padding:5px 12px;font-size:.7rem;border-radius:4px;cursor:pointer;border:1px solid var(--border);background:var(--surface3);color:var(--text)}

/* INPUT AREA */
.input-area{padding:15px 20px;background:var(--bg);border-top:1px solid var(--border)}
.input-wrap{max-width:900px;margin:0 auto;background:var(--surface);border:1px solid var(--border);border-radius:30px;display:flex;align-items:center;padding:6px 6px 6px 20px}
#user-input{flex:1;background:transparent;border:none;outline:none;color:var(--text);font-size:.95rem}
.send-btn{width:42px;height:42px;background:var(--gold);border:none;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:1.2rem}

@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
@media print { body * { visibility: hidden; } .legal-doc, .legal-doc * { visibility: visible; } .legal-doc { position: absolute; left: 0; top: 0; width: 100%; box-shadow: none !important; } }
</style>
</head>
<body>

<header>
  <div class="logo">
    <div class="logo-seal">⚖️</div>
    <div class="logo-text-group">
      <div class="logo-text">VakīlBot Pro</div>
      <div class="logo-tag">Indian Legal Drafting AI</div>
    </div>
  </div>
  
  <div class="status-badge">
    <div class="status-dot"></div>
    <span class="status-text">BNS 2025 ACTIVE</span>
  </div>
</header>

<div id="download-screen">
  <div class="dl-card">
    <div class="logo-seal" style="width:60px;height:60px;margin:0 auto 20px;font-size:30px">📜</div>
    <h2 style="margin-bottom:10px">Initialize BNS Engine</h2>
    <p style="color:var(--text-dim);font-size:.9rem">Loading local AI model for offline legal drafting & consulting.</p>
    <button class="dl-btn" id="dl-btn" onclick="startDownload()">Download Engine (1.3 GB)</button>
    <div class="progress-wrap" id="progress-wrap">
      <div class="progress-bar"><div class="progress-fill" id="prog-fill"></div></div>
      <div id="prog-status" style="font-size:.7rem;color:var(--text-dim)">Ready...</div>
    </div>
  </div>
</div>

<div id="chat-ui">
  <div class="tool-bar">
    <button class="tool-btn active" id="mode-chat" onclick="setMode('chat')">💬 BNS Consultant</button>
    <button class="tool-btn" id="mode-fir" onclick="setMode('fir')">✍️ BNSS FIR Draft</button>
    <button class="tool-btn" id="mode-notice" onclick="setMode('notice')">📑 Legal Notice</button>
  </div>

  <div id="chat-window">
    <div class="msg-row">
      <div class="av bot">⚖</div>
      <div class="msg bot">VakīlBot Pro active.
Under BNS 2023 & BNSS 2023. State your query concisely.</div>
    </div>
  </div>

  <div class="input-area">
    <div class="input-wrap">
      <input type="text" id="user-input" placeholder="Query BNS sections..." onkeydown="if(event.key==='Enter')sendMsg()">
      <button class="send-btn" id="send-btn" onclick="sendMsg()">➔</button>
    </div>
    <div style="text-align:center; font-size:.6rem; color:var(--text-dim); margin-top:8px; letter-spacing:1px">100% OFFLINE · NO DATA LEAVES DEVICE</div>
  </div>
</div>

<script type="module">
import * as webllm from "https://esm.run/@mlc-ai/web-llm";

const MODEL_ID = "Llama-3.2-1B-Instruct-q4f16_1-MLC";
let engine = null;
let currentMode = 'chat';

const PROMPTS = {
  chat: `You are a high-impact BNS 2025 legal assistant. 
  - ONLY use BNS (Bharatiya Nyaya Sanhita) and BNSS (Bharatiya Nagarik Suraksha Sanhita).
  - DO NOT use IPC or CrPC.
  - Structure: 1. Relevant Sections (Bold), 2. Legal Standing, 3. Action.
  - Be extremely concise. Use bullet points.`,
  
  fir: `Draft a high-impact FIR under BNSS 2023. 
  - Must start with specific BNS 2025 Section numbers.
  - Professional, direct, and fact-heavy.
  - Address to Station House Officer.
  - Format for high impact.`,
  
  notice: `Draft a sharp, professional Legal Notice. 
  - Cite relevant BNS 2025 breaches. 
  - 15-day ultimatum. 
  - Clear, legally binding tone.`
};

window.setMode = (mode) => {
  currentMode = mode;
  document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
  document.getElementById(`mode-${mode}`).classList.add('active');
  const placeholders = {
    chat: "Enter situation (e.g., mobile theft)...",
    fir: "Describe incident for FIR...",
    notice: "Enter dispute for Legal Notice..."
  };
  document.getElementById('user-input').placeholder = placeholders[mode];
};

window.startDownload = async function() {
  document.getElementById('dl-btn').style.display = 'none';
  document.getElementById('progress-wrap').style.display = 'block';
  try {
    engine = await webllm.CreateMLCEngine(MODEL_ID, {
      initProgressCallback: (r) => {
        document.getElementById('prog-fill').style.width = (r.progress * 100) + '%';
        document.getElementById('prog-status').textContent = r.text;
      }
    });
    document.getElementById('download-screen').style.display = 'none';
    document.getElementById('chat-ui').style.display = 'flex';
  } catch (e) { alert(e.message); }
};

window.sendMsg = async function() {
  const input = document.getElementById('user-input');
  const text = input.value.trim();
  if (!text || !engine) return;

  input.value = '';
  addMsg(text, 'user');

  const isDoc = (currentMode === 'fir' || currentMode === 'notice');
  const botRow = document.createElement('div');
  botRow.className = 'msg-row';
  if(isDoc) botRow.style.maxWidth = "100%";
  
  const msgDiv = document.createElement('div');
  msgDiv.className = `msg bot ${isDoc ? 'legal-doc' : ''}`;
  
  botRow.innerHTML = `<div class="av bot">⚖</div>`;
  botRow.appendChild(msgDiv);
  document.getElementById('chat-window').appendChild(botRow);

  let fullText = "";
  const stream = await engine.chat.completions.create({
    messages: [{ role: 'system', content: PROMPTS[currentMode] }, { role: 'user', content: text }],
    stream: true, 
    temperature: 0.1 
  });

  for await (const chunk of stream) {
    fullText += chunk.choices[0]?.delta?.content || '';
    msgDiv.textContent = fullText;
    document.getElementById('chat-window').scrollTop = document.getElementById('chat-window').scrollHeight;
  }

  if (isDoc) {
    const actions = document.createElement('div');
    actions.className = 'doc-actions';
    actions.innerHTML = `
      <button class="action-btn" onclick="copyText(this)">📋 Copy</button>
      <button class="action-btn" onclick="window.print()">🖨️ Print</button>
    `;
    document.getElementById('chat-window').appendChild(actions);
  }
};

function addMsg(t, role) {
  const r = document.createElement('div');
  r.className = `msg-row ${role}-row`;
  r.innerHTML = `<div class="av ${role}">${role==='bot'?'⚖':'You'}</div><div class="msg ${role}">${t}</div>`;
  document.getElementById('chat-window').appendChild(r);
  document.getElementById('chat-window').scrollTop = document.getElementById('chat-window').scrollHeight;
}

window.copyText = (btn) => {
  const doc = btn.parentElement.previousElementSibling.querySelector('.legal-doc') || btn.parentElement.previousElementSibling;
  navigator.clipboard.writeText(doc.textContent);
  btn.textContent = "✅ Copied";
  setTimeout(() => btn.textContent = "📋 Copy", 2000);
};
</script>
</body>
</html>